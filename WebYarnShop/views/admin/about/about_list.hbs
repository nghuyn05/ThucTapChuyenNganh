<div class="card shadow mb-4">
    <div class="card-header py-3 bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="m-0 font-weight-bold">Product Management</h5>
        <a href="/admin/about/create" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-plus"></i> Add
        </a>
    </div>

    <div class="card-body bg-light">
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-primary text-dark">
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Description</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Address</th>
                    <th scope="col">Edit</th>
                    <th scope="col">Delete</th>
                </tr>
                </thead>
                <tbody>
                {{#each abouts}}
                    <tr>
                        <th scope="row">{{_id}}</th>
                        <td style="max-width: 300px">{{description}}</td>
                        <td>{{phone}}</td>
                        <td>{{address}}</td>
                        <td>
                            <a href="/admin/about/edit/{{_id}}">
                                <i class="fa-solid fa-pen-to-square text-warning"></i>
                            </a>
                        </td>
                        <td>
                            <form action="/admin/about/{{_id}}?_method=DELETE" method="post">
                                <button type="submit" class="border-0">
                                    <i class="fa-solid fa-trash text-danger"></i>
                                </button>
                            </form>

                        </td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer text-muted text-end small">
    </div>
</div>
