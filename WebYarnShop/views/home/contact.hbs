<!-- inner page section -->
<section class="inner_page_head">
    <div class="container_fuild">
        <div class="row">
            <div class="col-md-12">
                <div class="full">
                    <h3>Contact us</h3>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end inner page section -->
<!-- contact section -->
<section class="why_section layout_padding">
    <div class="container">
<!--        Thành công-->
        {{#if success}}
            <div class="alert alert-success">
                {{success_message}}
            </div>
        {{/if}}

        <!--        thông báo lỗi -->
        {{#if error_message}}
            <div class="alert alert-danger">
                {{error_message}}
            </div>
        {{/if}}
        {{#if errors}}
            {{#each errors}}
                <div class="alert alert-danger">
                    {{message}}
                </div>
            {{/each}}
        {{/if}}
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="full">
                    <!-- form contact -->
                    <form action="/contact/submit" method="POST">
                        <fieldset>
                            <input type="text" name="fullName" value="{{fullName}}" placeholder="Enter your full name"/>
                            <input type="email" name="email" value="{{email}}" placeholder="Enter your email address"/>
                            <input type="text" name="subject" value="{{subject}}" placeholder="Enter subject"/>
                            <textarea name="message" placeholder="Enter your message">{{message}}</textarea>
                            <input type="submit" value="Submit" />
                        </fieldset>
                    </form>
                    <!-- end form -->
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end contact section -->


