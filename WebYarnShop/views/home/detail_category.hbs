<!-- inner page section -->
<section class="inner_page_head">
    <div class="container_fuild">
        <div class="row">
            <div class="col-md-12">
                <div class="full">
                    <h3>{{category.name}}</h3>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end inner page section -->
<div class="container py-5">
    <div class="row g-4">
        {{#if products}}
            {{#each products}}
                <div class="col-md-6 col-lg-4 d-flex">
                    <div class="product-card border rounded-3 h-100 w-100 d-flex flex-column">

                        <img src="{{image}}" class="img-fluid rounded-top product-img" alt=" " />

                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <h5 class="fw-semibold">{{name}}</h5>

                            <p class="text-muted small">
                                {{description}}
                            </p>

                            <div class="mb-3">
                                <span class="badge border border-success text-success">
                                    Còn {{quantity}} sản phẩm
                                </span>
                                <span class="badge border border-dark text-black">
                                    {{price}} VNĐ
                                </span>
                            </div>

                            <a href="/products/{{_id}}" class="btn btn-danger w-100 mt-auto">
                                Detail Product
                            </a>
                        </div>
                    </div>
                </div>
            {{/each}}
        {{else}}
            <p class="text-center">Danh mục này chưa có sản phẩm</p>
        {{/if}}

    </div>
</div>
